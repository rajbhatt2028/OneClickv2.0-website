<?xml version="1.0" encoding="UTF-8"?>
<!--
  OneClicq — IIS (Windows hosting) settings. The equivalent of .htaccess,
  which IIS ignores. Upload to the site root next to index.html.

  Everything active below uses only built-in IIS features, so it is safe on
  any IIS 10 host. The URL-rewrite rules at the bottom need the IIS
  "URL Rewrite" module: uncomment them only if your host has it installed
  (most Plesk/Windows hosts do). If the site shows "500 Internal Server
  Error" after uploading, rename this file and contact the host.
-->
<configuration>
  <system.webServer>

    <!-- Security headers (fix plan M12) -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>

    <!-- File types IIS does not serve by default (WebP photos were returning 404) -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- pages: 10 minutes, so updates show quickly (assets/ gets 30 days, see bottom) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
    </staticContent>

    <!-- Keep build tools, config and notes off the web -->
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="tools" />
          <add segment="includes" />
          <add segment="private_uploads" />
          <add segment=".claude" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".htaccess" allowed="false" />
        </fileExtensions>
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Branded 404 page (fix plan H7). If the host locks this setting the site
         returns a 500 error; delete this <httpErrors> block in that case. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <!-- "File" keeps the real 404 status code; "ExecuteURL" would send 200 (a soft 404 for Google) -->
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ===== Needs the IIS URL Rewrite module: uncomment if installed =====
    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTPS}" pattern="off" /></conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Duplicate home pages" stopProcessing="true">
          <match url="^(index|oneclicq-home)\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Removed pages" stopProcessing="true">
          <match url="^(resources|blog)\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Old cloud link" stopProcessing="true">
          <match url="^services/cloud-devops\.html$" />
          <action type="Redirect" url="/services/cloud-migration.html" redirectType="Permanent" />
        </rule>
        <rule name="Old data link" stopProcessing="true">
          <match url="^services/data-analytics\.html$" />
          <action type="Redirect" url="/solutions/business-intelligence.html" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Hide server header">
          <match serverVariable="RESPONSE_Server" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>
    ===================================================================== -->

  </system.webServer>

  <!-- CSS/JS/images are versioned (?v=6), so they can be cached for 30 days -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
